<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f1;font-family:Helvetica,Arial,sans-serif;color:#17241b">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f1;padding:32px 12px">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e3e9df">
        <tr><td style="background:#0f3a1e;padding:22px 28px">
          <span style="display:inline-block;width:28px;height:28px;border-radius:8px;background:#6cc56f;vertical-align:middle"></span>
          <span style="font-family:Georgia,serif;font-size:20px;font-weight:bold;color:#ffffff;vertical-align:middle;margin-left:8px">Rafanutri</span>
        </td></tr>
        <tr><td style="padding:28px">
          <h1 style="margin:0 0 14px;font-family:Georgia,serif;font-size:22px;line-height:1.25;color:#17241b">{{ subject }}</h1>
          {% for p in paragraphs %}<p style="margin:0 0 14px;font-size:15px;line-height:1.55;color:#4b5d52">{{ p }}</p>{% endfor %}
          {% if link %}
          <p style="margin:22px 0">
            <a href="{{ link }}" target="_blank" rel="noopener" style="display:inline-block;background:#6cc56f;color:#0b1f10;font-size:16px;font-weight:bold;text-decoration:none;padding:13px 26px;border-radius:12px">{{ linkLabel }}</a>
          </p>
          <p style="margin:0 0 8px;font-size:12px;line-height:1.5;word-break:break-all;color:#2f7a3d">{{ link }}</p>
          {% endif %}
          <p style="margin:18px 0 0;font-size:13px;line-height:1.5;color:#6b7c70">Dica: receba os avisos de graça e na hora pelo Telegram. Ative na sua área do paciente.</p>
        </td></tr>
        <tr><td style="padding:16px 28px;border-top:1px solid #e3e9df;font-size:12px;line-height:1.5;color:#8a9a8e">
          Rafanutri · Este é um e-mail automático; não responda.
          {% if unsubscribe %}<br><a href="{{ unsubscribe }}" style="color:#8a9a8e">Não quero mais receber avisos por e-mail</a>{% endif %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
